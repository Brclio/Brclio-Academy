{
  "name": "brclio-academy",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "admin": "tsx --env-file-if-exists=.env.local scripts/admin.ts",
    "data:export": "tsx --env-file-if-exists=.env.local scripts/data.ts export",
    "data:import": "tsx --env-file-if-exists=.env.local scripts/data.ts import",
    "format": "prettier --write src scripts tests next.config.ts package.json tsconfig.json",
    "audit:client": "node scripts/audit-client.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "nodemailer": "10.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
