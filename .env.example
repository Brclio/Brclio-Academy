# Copy to .env.local for development. Never commit a populated environment file.
APP_URL=http://localhost:3000

# sqlite: one persistent server; github: Vercel / low-write deployments.
DATA_DRIVER=sqlite
SQLITE_PATH=.data/academy.sqlite

# Required only for DATA_DRIVER=github. Use a separate PRIVATE data repository.
# Generate once: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
GH_DATA_TOKEN=
GH_DATA_OWNER=
GH_DATA_REPO=
GH_DATA_BRANCH=main
GH_DATA_PATH=academy.enc.json

# console is explicitly development-only; it does NOT send a real email.
MAIL_TRANSPORT=console
DEV_MAIL_FILE=.data/dev-mail.jsonl
MAIL_FROM=Brclio Academy <noreply@example.com>

# Production option A: SMTP. 587 uses STARTTLS; 465 uses SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Production option B: Resend with a verified sender domain.
RESEND_API_KEY=

# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# ADMIN_PASSWORD is used only during the administrator bootstrap command.
# Set it temporarily in your shell; do not retain it in production configuration.
